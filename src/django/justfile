#!/usr/bin/env just --justfile

[group('help')]
[private]
default:
    @ just --list --list-heading $'justfile manual page:\n'

# show help
[group('help')]
help: default

style:
    just format
    just lint

check:
    just style
    just test
    just test-coverage

# lints codebase using golangci-lint
[group('lint')]
lint:
    @ uvx ruff check .

# lints and fixes codebase using ruff
[group('lint')]
fix:
    @ uvx ruff check . --fix

# formats codebase using ruff
[group('lint')]
format:
    @ uvx ruff format .

alias fmt := format

# run tests
[group('test')]
test:
    @ uv run python manage.py test

# run tests with coverage report
[group('test')]
test-coverage:
    @ uv run coverage run --source="." manage.py test

# generates migrations
[group('generate')]
generate-migrations:
    @ uv run python manage.py makemigrations

alias m := generate-migrations
